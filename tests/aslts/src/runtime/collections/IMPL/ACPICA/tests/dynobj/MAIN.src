            PP00 [C019] = 0x01 /* LOCAL_REGION_FIELD */
            PP01 = M3A8 ()
            PP02 = M3A9 ()
            PP02 [C228] = 0x01 /* CLIST_ID_OPERAND */
            M3A4 (Local0, PP0A, Local1, PP00, PP01, PP02, 0x08)
        }

        /* ======================== BankField */

