            TEMP = CondRefOf (I003)
            _TCI (C201, PP0A)
            M3A3 (Local0, PP0A, Local1)
            PP00 = M3A8 ()
            PP00 [C009] = 0x02 /* Integer */
            PP00 [C01C] = 0x01 /* LOCAL_REFERENCE */
            M3A4 (Local0, PP0A, Local1, PP00, 0x00, 0x00, 0x21)
