        "module"
    })
    /* Names of complex tests */

    Name (TNC0, Package (0x14)
    {
        "misc",
        "provoke",
        "oarg",
        "oconst",
        "olocal",
        "oreturn",
        "onamedloc",
        "onamedglob",
        "opackageel",
        "oreftonamed",
        "oconversion",
        "oreftopackageel",
        "rstore",
        "roptional",
